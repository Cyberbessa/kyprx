# Derived from Klassy's KlassyDark.colors, whose sections, keys and colour effects it keeps, and so
# under that file's licence and with its authors above. The palette's own credit is in CREDITS.md.
#
# Dracula (KyprX), for KyprX.
# Palette: draculatheme.com -- the official specification
# Built against /usr/share/color-schemes/KlassyDark.colors: same sections, same keys,
# no [Colors:Header] (so the header follows the window, as Klassy does), and an explicit
# [WM] with an alpha on the active bar.

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
