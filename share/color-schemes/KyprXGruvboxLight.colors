#
# Gruvbox Light (KyprX), for KyprX.
# Palette: github.com/morhetz/gruvbox -- light, medium contrast
# Built against /usr/share/color-schemes/KlassyDark.colors: same sections, same keys,
# no [Colors:Header] (so the header follows the window, as Klassy does), and an explicit
# [WM] with an alpha on the active bar.

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

